# =============================================================================
# CodeAudit environment configuration
# Copy to `.env` (git-ignored):  cp .env.example .env
#
# docker-compose reads this file. Hostnames below point at localhost so the
# API/worker can also run directly on your machine; docker-compose overrides
# DATABASE_URL, REDIS_URL, CELERY_*, S3_ENDPOINT_URL with in-network hostnames.
# =============================================================================

# ----- Application -----------------------------------------------------------
# development | staging | production
ENVIRONMENT=development
DEBUG=false
LOG_LEVEL=INFO
# Prefix for API routes (/health is always at the root)
API_PREFIX=/api
# JSON list of allowed browser origins
CORS_ORIGINS=["http://localhost:5173"]

# ----- PostgreSQL ------------------------------------------------------------
POSTGRES_USER=codeaudit
POSTGRES_PASSWORD=change-me-postgres
POSTGRES_DB=codeaudit
# SQLAlchemy URL used by the app and Alembic (must match the values above)
DATABASE_URL=postgresql+psycopg2://codeaudit:change-me-postgres@localhost:5432/codeaudit

# ----- Redis / Celery --------------------------------------------------------
# General-purpose Redis (health checks, caching, rate limiting)
REDIS_URL=redis://localhost:6379/0
# Celery broker and result backend (separate logical DBs)
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2
# Number of concurrent scan jobs per worker container
CELERY_CONCURRENCY=2

# ----- Object storage (MinIO locally, any S3-compatible store in prod) -------
# Image override (MinIO no longer publishes to Docker Hub; default is quay.io)
# MINIO_IMAGE=quay.io/minio/minio:RELEASE.2025-09-07T16-13-09Z
# MinIO root credentials (user >= 3 chars, password >= 8 chars)
MINIO_ROOT_USER=codeaudit
MINIO_ROOT_PASSWORD=change-me-minio
# Credentials the app uses (locally the MinIO root user; use a scoped key in prod)
S3_ENDPOINT_URL=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=codeaudit
S3_SECRET_ACCESS_KEY=change-me-minio
S3_BUCKET_UPLOADS=codeaudit-uploads

# ----- LLM (Anthropic) -------------------------------------------------------
# Required only for fix suggestions. Leave empty to run without the LLM layer.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5

# ----- Uploads ---------------------------------------------------------------
MAX_UPLOAD_SIZE_MB=50
MAX_ARCHIVE_FILES=10000
# Limits enforced on actual decompressed bytes during extraction
MAX_EXTRACTED_SIZE_MB=500
MAX_EXTRACTED_FILE_SIZE_MB=50

# ----- Scans -----------------------------------------------------------------
# Hard limit for the whole scan task (download + extract + analyze + persist)
SCAN_TIMEOUT_SECONDS=900
# Celery retries for transient infrastructure errors only
SCAN_MAX_RETRIES=2
# Where the worker materialises per-scan workspaces (inside the container)
SCAN_WORKSPACE_DIR=/var/lib/codeaudit/workspace

# ----- Sandbox (analyzers in Docker) -----------------------------------------
# Named volume backing SCAN_WORKSPACE_DIR when the worker runs in a container
# (set by docker-compose). Leave empty when the worker runs on the host.
SANDBOX_WORKSPACE_VOLUME=
# Group id owning /var/run/docker.sock inside containers (Docker Desktop: 0)
DOCKER_SOCKET_GID=0
SEMGREP_IMAGE=returntocorp/semgrep:1.177.0
SEMGREP_TIMEOUT_SECONDS=300
SEMGREP_MEMORY_LIMIT=2g
SEMGREP_CPUS=2
# Rule packs are fetched by the worker and cached; the sandbox has no network
SEMGREP_RULES_MAX_AGE_HOURS=24

# ----- Other analyzers (each in its own sandbox container, run concurrently) --
ANALYZER_MAX_WORKERS=4
# No version tags are published for Bandit's image; pinned by digest (bandit 1.9.4)
BANDIT_IMAGE=ghcr.io/pycqa/bandit/bandit@sha256:67e9ecb7cfa64a398b59f125d27a193a13679affc79edf6bcb95f05cb82d2600
BANDIT_TIMEOUT_SECONDS=180
BANDIT_MEMORY_LIMIT=1g
BANDIT_CPUS=1
RUFF_IMAGE=ghcr.io/astral-sh/ruff:0.16.7
RUFF_TIMEOUT_SECONDS=120
RUFF_MEMORY_LIMIT=512m
RUFF_CPUS=1
OSV_SCANNER_IMAGE=ghcr.io/google/osv-scanner:v2.5.1
OSV_SCANNER_TIMEOUT_SECONDS=300
OSV_SCANNER_MEMORY_LIMIT=2g
OSV_SCANNER_CPUS=1
# Offline vulnerability databases (per ecosystem, e.g. npm ~200 MB) are fetched
# by the worker and cached; the sandbox has no network
OSV_DB_MAX_AGE_HOURS=24

# ----- Architecture graph (tree-sitter, runs in a child process of the worker) -
ARCHITECTURE_TIMEOUT_SECONDS=300

# ----- Host port mappings (change if a port is already in use) ---------------
API_HOST_PORT=8000
POSTGRES_HOST_PORT=5432
REDIS_HOST_PORT=6379
MINIO_API_HOST_PORT=9000
MINIO_CONSOLE_HOST_PORT=9001

# ----- Frontend (Vite) -------------------------------------------------------
# Configured separately in frontend/.env (see frontend/.env.example)
