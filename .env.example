# =============================================================================
# CodeAudit environment configuration
# Copy to `.env` (git-ignored):  cp .env.example .env
#
# docker-compose reads this file. Hostnames below point at localhost so the
# API/worker can also run directly on your machine; docker-compose overrides
# DATABASE_URL, REDIS_URL, CELERY_*, S3_ENDPOINT_URL with in-network hostnames.
# =============================================================================

# ----- Application -----------------------------------------------------------
# development | staging | production
ENVIRONMENT=development
DEBUG=false
LOG_LEVEL=INFO
# Prefix for API routes (/health is always at the root)
API_PREFIX=/api
# JSON list of allowed browser origins
CORS_ORIGINS=["http://localhost:5173"]
APP_NAME=CodeAudit
# json (production, log shippers) | text (readable local output)
LOG_FORMAT=json
# Reverse proxies in front of the API whose X-Forwarded-For is trusted for client IPs
# (per-IP limits). 0 = use the socket address. Caddy in docker-compose.prod.yml = 1.
TRUSTED_PROXY_HOPS=0

# ----- Observability -----------------------------------------------------------
# Errors and traces to Sentry (request bodies, cookies, headers and locals are scrubbed)
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.0
# Bearer token required on the API's /metrics (empty = open; keep it off the public edge)
METRICS_TOKEN=
# Worker metrics endpoint in the Celery main process (0 disables)
WORKER_METRICS_PORT=9100
# Prompt/response text of LLM calls contains user code: deleted after this many days
LLM_TRANSCRIPT_RETENTION_DAYS=30

# ----- Quotas (rolling windows; per user, or per client IP when signed out) -----
# Per-user overrides and tier changes: PATCH /api/admin/users/{id}/quota
QUOTA_ANONYMOUS_REQUESTS_PER_MINUTE=120
QUOTA_ANONYMOUS_SCANS_PER_DAY=10
QUOTA_ANONYMOUS_SITE_ANALYSES_PER_DAY=10
# One pool shared by all anonymous scans
QUOTA_ANONYMOUS_LLM_TOKENS_PER_MONTH=2000000
QUOTA_FREE_REQUESTS_PER_MINUTE=300
QUOTA_FREE_SCANS_PER_DAY=50
QUOTA_FREE_SITE_ANALYSES_PER_DAY=50
QUOTA_FREE_PULL_REQUESTS_PER_DAY=10
QUOTA_FREE_PR_PREVIEWS_PER_HOUR=60
QUOTA_FREE_LLM_TOKENS_PER_MONTH=5000000
QUOTA_PRO_REQUESTS_PER_MINUTE=1200
QUOTA_PRO_SCANS_PER_DAY=500
QUOTA_PRO_SITE_ANALYSES_PER_DAY=500
QUOTA_PRO_PULL_REQUESTS_PER_DAY=100
QUOTA_PRO_PR_PREVIEWS_PER_HOUR=300
QUOTA_PRO_LLM_TOKENS_PER_MONTH=50000000

# ----- PostgreSQL ------------------------------------------------------------
POSTGRES_USER=codeaudit
POSTGRES_PASSWORD=change-me-postgres
POSTGRES_DB=codeaudit
# SQLAlchemy URL used by the app and Alembic (must match the values above)
DATABASE_URL=postgresql+psycopg2://codeaudit:change-me-postgres@localhost:5432/codeaudit

# ----- Redis / Celery --------------------------------------------------------
# General-purpose Redis (health checks, caching, rate limiting)
REDIS_URL=redis://localhost:6379/0
# Celery broker and result backend (separate logical DBs)
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2
# Number of concurrent scan jobs per worker container
CELERY_CONCURRENCY=2

# ----- Object storage (MinIO locally, any S3-compatible store in prod) -------
# Image override (MinIO no longer publishes to Docker Hub; default is quay.io)
# MINIO_IMAGE=quay.io/minio/minio:RELEASE.2025-09-07T16-13-09Z
# MinIO root credentials (user >= 3 chars, password >= 8 chars)
MINIO_ROOT_USER=codeaudit
MINIO_ROOT_PASSWORD=change-me-minio
# Credentials the app uses (locally the MinIO root user; use a scoped key in prod)
S3_ENDPOINT_URL=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=codeaudit
S3_SECRET_ACCESS_KEY=change-me-minio
S3_BUCKET_UPLOADS=codeaudit-uploads

# ----- LLM ---------------------------------------------------------------------
# anthropic = Claude API (paid, needs ANTHROPIC_API_KEY)
# ollama    = free local model via Ollama (https://ollama.com): `ollama pull qwen2.5-coder:7b`
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6
# From inside Docker containers use http://host.docker.internal:11434
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5-coder:7b
# Optional: a model that reads images, for the Site Analyzer's design summary (e.g. qwen2.5vl:7b)
OLLAMA_VISION_MODEL=
# Context window requested per call; Ollama's own default silently truncates long prompts
OLLAMA_NUM_CTX=16384
OLLAMA_MAX_OUTPUT_TOKENS=4096
OLLAMA_TIMEOUT_SECONDS=600
OLLAMA_KEEP_ALIVE=10m
# LLM enrichment (fix suggestions + architecture review) runs after analysis as its own
# task; the scan is complete without it. Skipped when disabled or no API key is set.
LLM_ENABLED=true
# Hard ceiling on input + output tokens per scan: calls that could exceed it are refused
LLM_TOKEN_BUDGET_PER_SCAN=400000
LLM_MAX_OUTPUT_TOKENS=16000
# Adaptive thinking effort: low | medium | high | max
LLM_EFFORT=medium
LLM_TIMEOUT_SECONDS=180
LLM_MAX_RETRIES=4
# Highest-priority findings that get a fix suggestion, and similar findings per request
LLM_MAX_FIX_FINDINGS=20
LLM_MAX_FINDINGS_PER_REQUEST=5
LLM_CONTEXT_LINES=20
LLM_TASK_TIMEOUT_SECONDS=1800
LLM_RETRY_MAX_DELAY_SECONDS=60
# Global spend cap per UTC day, including in-flight estimates. 0 turns LLM calls off.
# Operators can also flip the kill switch: POST /api/admin/llm-kill-switch
LLM_DAILY_SPEND_CAP_USD=50
# Log (and post to ALERT_WEBHOOK_URL) when today's spend crosses this share of the cap
LLM_SPEND_ALERT_RATIO=0.8
# Slack-compatible incoming webhook ({"text": ...}); empty = log only
ALERT_WEBHOOK_URL=

# ----- Accounts & GitHub -----------------------------------------------------
# Where the web app runs; OAuth sign-in redirects back here.
FRONTEND_URL=http://localhost:5173
SESSION_TTL_HOURS=336
# true in production (HTTPS only)
SESSION_COOKIE_SECURE=false
# Fernet key(s) encrypting stored GitHub tokens. Comma-separated: the first encrypts,
# all decrypt (rotation). Generate one with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEYS=
# GitHub OAuth app (Settings -> Developer settings -> OAuth Apps). Callback URL:
#   http://localhost:8000/api/auth/github/callback
# Without these, public repositories can still be scanned by URL; sign-in, private
# repositories and pull requests are disabled.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_TIMEOUT_SECONDS=20
GITHUB_OAUTH_URL=https://github.com
GITHUB_API_URL=https://api.github.com
# Repositories larger than this (GitHub's reported size) are refused before cloning
GITHUB_MAX_REPO_SIZE_MB=200
GIT_CLONE_TIMEOUT_SECONDS=300
GIT_CLONE_MEMORY_LIMIT=1g
GIT_IMAGE=alpine/git@sha256:0b5f57d22181e8b8fbe8ac5ca8754faa0d577f101b9857418f1acc43955ad464
# How long to wait for a new fork to become usable when opening a PR from a fork
GITHUB_FORK_WAIT_SECONDS=60

# ----- Website analyzer --------------------------------------------------------
# Capture sandbox image; build it once with: docker compose build web-capture
WEB_CAPTURE_IMAGE=codeaudit-web-capture:1.63.0
# Internal Docker network whose only exit is the egress proxy (created by compose)
WEB_CAPTURE_NETWORK=codeaudit_web_capture
WEB_EGRESS_PROXY_URL=http://egress-proxy:8888
WEB_CAPTURE_TIMEOUT_SECONDS=30
WEB_PAGE_TIMEOUT_MS=20000
WEB_CAPTURE_MEMORY_LIMIT=1536m
WEB_CAPTURE_CPUS=1.5
WEB_HTTP_TIMEOUT_SECONDS=10
WEB_MAX_REDIRECTS=10
# Reuse a completed analysis of the same normalized URL within this window
SITE_CACHE_TTL_SECONDS=21600
# Optional reputation source (Google Cloud API key with Safe Browsing API enabled)
GOOGLE_SAFE_BROWSING_API_KEY=
OPENPHISH_FEED_URL=https://openphish.com/feed.txt
OPENPHISH_CACHE_SECONDS=3600
RDAP_BOOTSTRAP_URL=https://rdap.org
# Token budget for the design vision call per site analysis
LLM_TOKEN_BUDGET_PER_SITE=60000

# ----- Uploads ---------------------------------------------------------------
MAX_UPLOAD_SIZE_MB=50
MAX_ARCHIVE_FILES=10000
# Limits enforced on actual decompressed bytes during extraction
MAX_EXTRACTED_SIZE_MB=500
MAX_EXTRACTED_FILE_SIZE_MB=50

# ----- Scans -----------------------------------------------------------------
# Hard limit for the whole scan task (download + extract + analyze + persist)
SCAN_TIMEOUT_SECONDS=900
# Celery retries for transient infrastructure errors only
SCAN_MAX_RETRIES=2
# Where the worker materialises per-scan workspaces (inside the container)
SCAN_WORKSPACE_DIR=/var/lib/codeaudit/workspace
# Mark scans stuck past their time limit (plus this grace) as failed (beat, every 5 min)
STALE_JOB_GRACE_SECONDS=300
# Identical input (same upload bytes, or same repository commit) analyzed by the same
# analyzer versions within this window is served from the earlier scan. 0 disables.
SCAN_CACHE_TTL_SECONDS=604800
# Tests only: run tasks inline
CELERY_TASK_ALWAYS_EAGER=false

# ----- Sandbox (analyzers in Docker) -----------------------------------------
# Named volume backing SCAN_WORKSPACE_DIR when the worker runs in a container
# (set by docker-compose). Leave empty when the worker runs on the host.
SANDBOX_WORKSPACE_VOLUME=
# Group id owning /var/run/docker.sock inside containers (Docker Desktop: 0)
DOCKER_SOCKET_GID=0
# Analyzer/clone/capture containers running at once across ALL workers (Redis-backed
# semaphore); bursts queue here. Size to host RAM: Semgrep alone may use 2 GB.
MAX_CONCURRENT_SANDBOXES=6
# How long a sandbox waits for a free slot before the scan fails as retryable
SANDBOX_SLOT_TIMEOUT_SECONDS=900
SEMGREP_IMAGE=returntocorp/semgrep:1.177.0
SEMGREP_TIMEOUT_SECONDS=300
SEMGREP_MEMORY_LIMIT=2g
SEMGREP_CPUS=2
# Rule packs are fetched by the worker and cached; the sandbox has no network
SEMGREP_RULES_MAX_AGE_HOURS=24

# ----- Other analyzers (each in its own sandbox container, run concurrently) --
ANALYZER_MAX_WORKERS=4
# No version tags are published for Bandit's image; pinned by digest (bandit 1.9.4)
BANDIT_IMAGE=ghcr.io/pycqa/bandit/bandit@sha256:67e9ecb7cfa64a398b59f125d27a193a13679affc79edf6bcb95f05cb82d2600
BANDIT_TIMEOUT_SECONDS=180
BANDIT_MEMORY_LIMIT=1g
BANDIT_CPUS=1
RUFF_IMAGE=ghcr.io/astral-sh/ruff:0.16.7
RUFF_TIMEOUT_SECONDS=120
RUFF_MEMORY_LIMIT=512m
RUFF_CPUS=1
OSV_SCANNER_IMAGE=ghcr.io/google/osv-scanner:v2.5.1
OSV_SCANNER_TIMEOUT_SECONDS=300
OSV_SCANNER_MEMORY_LIMIT=2g
OSV_SCANNER_CPUS=1
# Offline vulnerability databases (per ecosystem, e.g. npm ~200 MB) are fetched
# by the worker and cached; the sandbox has no network
OSV_DB_MAX_AGE_HOURS=24

# ----- Architecture graph (tree-sitter, runs in a child process of the worker) -
ARCHITECTURE_TIMEOUT_SECONDS=300

# ----- Host port mappings (change if a port is already in use) ---------------
API_HOST_PORT=8000
WORKER_METRICS_HOST_PORT=9100
POSTGRES_HOST_PORT=5432
REDIS_HOST_PORT=6379
MINIO_API_HOST_PORT=9000
MINIO_CONSOLE_HOST_PORT=9001

# ----- Frontend (Vite) -------------------------------------------------------
# Configured separately in frontend/.env (see frontend/.env.example)
